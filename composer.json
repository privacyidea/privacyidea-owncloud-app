{
    "name": "privacyidea/owncloud-app-dev",
    "description": "Development tools for the privacyIDEA ownCloud app. The app itself needs no packages.",
    "license": "AGPL-3.0-only",
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\TwoFactor_privacyIDEA\\": "twofactor_privacyidea/lib/",
            "Tests\\Unit\\": "tests/unit/"
        }
    },
    "scripts": {
        "lint": "find twofactor_privacyidea tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test:unit": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
