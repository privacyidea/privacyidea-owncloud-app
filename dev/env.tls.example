# Third stack with HTTPS, for passkeys with a real authenticator. See dev/README.md.
# Copy this file to dev/env.tls (git-ignored) and set TLS_CERT_FILE and TLS_KEY_FILE.
DEV_PROJECT=pi-owncloud-dev-tls
DEV_STATE=tls
DEV_OVERLAY=compose-tls.yml

# Direct HTTP ports of the stack. The tests and the setup scripts use them.
OWNCLOUD_PORT=8100
PRIVACYIDEA_PORT=8101

# The HTTPS addresses for the browser. Both names must resolve to this PC (hosts file: 127.0.0.1).
OWNCLOUD_TLS_HOST=owncloud-dev.lab.local
OWNCLOUD_TLS_PORT=8443
PRIVACYIDEA_TLS_HOST=pi-dev.lab.local
PRIVACYIDEA_TLS_PORT=8444

# The relying party id of the passkeys. It must be the host name of both addresses or a parent domain of both.
PI_RP_ID=lab.local

# Optional: privacyIDEA reads the users of the OpenLDAP of the privacyidea repository (container pi-openldap-test,
# users user001 to user100, password Test1234!). The setup script connects the container to the network of this stack.
# ownCloud has local users with the same names (DEV_EXTRA_USERS). Remove the lines to use only the local test users.
PI_LDAP_URI=ldap://pi-openldap-test:389
PI_LDAP_BASE=ou=people,dc=example,dc=org
PI_LDAP_BIND_DN=cn=admin,dc=example,dc=org
PI_LDAP_BIND_PW=admin
DEV_EXTRA_USERS="user001 user002 user003"

# A passkey challenge reaches the app only with "Trigger challenges".
DEV_TRIGGERCHALLENGES=1

# Certificate chain and key (PEM) for both host names. The browser must trust the CA.
# Use paths that WSL can read. Do not copy the files into this repository.
TLS_CERT_FILE=/mnt/c/path/to/fullchain.pem
TLS_KEY_FILE=/mnt/c/path/to/key.pem

# For the e2e tests: the address of ownCloud, and a rule that lets Chromium find the names without a hosts file entry.
OWNCLOUD_URL=https://owncloud-dev.lab.local:8443
E2E_HOST_MAP="MAP *.lab.local 127.0.0.1"
